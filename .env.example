# Copy to .env and fill in. .env is gitignored, so secrets stay off GitHub.

# Express API port (npm run api)
PORT=4000

# Frontend: where the API lives. Leave unset: in dev Vite proxies /api, and in
# production Express serves the site and the API from one origin.
# VITE_API_URL=https://your-api-host.example.com/api

# How many proxies sit in front of the server. 0 locally, 1 on Render.
# Check it after deploying: /api/health/ip should show your real IP.
# TRUST_PROXY=0

# Signs login tokens. Anyone who knows it can log in as any user, so make it
# long and random, keep it out of git, and use a different one in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The Postgres database (Neon: dashboard -> Connect -> copy the connection string).
# Leave it unset to use PGlite instead: a local Postgres kept in data/pglite,
# fine for development and tests. On Render, set it in the dashboard.
# DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Where PGlite keeps its files when DATABASE_URL is unset (default data/pglite).
# PGLITE_DIR=data/pglite
# Optional: a second Postgres just for event reactions (e.g. another Neon project).
# Unset = reactions live in the main database.
# REACTIONS_DATABASE_URL=postgresql://user:password@ep-other-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Switch feature modules off, comma separated (alerts, community, events, reactions, services, eco, wallet, impact).
# Their /api routes then answer 404. GET /api/features lists what is on.
# FEATURES_OFF=

# Live area status from EskomSePush (free key: https://eskomsepush.gumroad.com/l/api).
# Leave empty to keep demo data. The free key allows 50 calls a day; the API
# caches answers so normal use stays around 36 calls a day.
# ESKOMSEPUSH_TOKEN=
# Your schedule id, e.g. eskde-10 (v3.1 splits areas and schedules).
# Find your area: npm run eskom:areas -- "fourways"
# Then its schedules: npm run eskom:areas -- --area za_gt_jhb_fourways_4pef
# ESKOMSEPUSH_SCHEDULE=
# Your area id, for neighbour reports (power and water off/on right now).
# ESKOMSEPUSH_AREA=za_gt_eku_kemptonpark_gltt
# Only if EskomSePush moves to a new API version (default is v3.1).
# ESKOMSEPUSH_BASE_URL=https://developer.sepush.co.za/business/3.1

# Nearby facilities come from OpenStreetMap's Overpass API (no key needed).
# Only set this to use a different Overpass server.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Official SA Weather Service warnings (CAP RSS feed, no key). Set to off to skip it.
# SAWS_CAP_URL=http://caps.weathersa.co.za/Home/RssFeed

# Climate news comes from free RSS feeds (no key). Set to off to show only the
# bundled snapshot of real stories in shared/newsSnapshot.js.
# NEWS_FEEDS=off

# Optional demo login for judges, made at start if it doesn't exist yet.
# DEMO_EMAIL=demo@eco5.app
# DEMO_PASSWORD=at-least-8-characters
# DEMO_NAME=Demo
