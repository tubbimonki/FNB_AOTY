# Copy to .env and fill in. .env is gitignored, so secrets stay off GitHub.

# Express API port (npm run api)
PORT=4000

# Frontend: where the API lives. Leave unset in dev (Vite proxies /api).
# VITE_API_URL=https://your-api-host.example.com/api

# Signs login tokens. Anyone who knows it can log in as any user, so make it
# long and random, keep it out of git, and use a different one in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the SQLite database file lives (default data/app.db).
# DATABASE_FILE=data/app.db
